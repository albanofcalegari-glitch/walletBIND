# App
PORT=3000
JWT_SECRET=walletbind-dev-secret-change-in-prod

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet_bind

# BIND PSP Credentials (provistas por el equipo de integracion de BIND)
BIND_AUTH_URL=https://login.microsoftonline.com/{tenant_id}/oauth2/v2.0/token
BIND_CLIENT_ID=your_client_id
BIND_CLIENT_SECRET=your_client_secret

# Environment: staging | production
BIND_ENV=staging

# Staging
BIND_STAGING_URL=https://gw-staging-qrbind.epays.services
BIND_STAGING_SCOPE=api://staging-bind.epays.services/.default

# Production
BIND_PROD_URL=https://api.bindpagos.com.ar
BIND_PROD_SCOPE=api://bindpagos.com.ar/.default
